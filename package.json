{
  "name": "campus-plug",
  "version": "1.0.0",
  "description": "Tactical-aesthetic student marketplace web application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test:security": "node scripts/security-regression.mjs",
    "test:security:supabase": "node scripts/supabase-security-regression.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security:all": "npm run test:security && npm run test:security:supabase && npm run test",
    "gen:types": "supabase gen types typescript --project-id etwsfdovcgofhqseejjo > src/types/database.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:link": "supabase link --project-ref etwsfdovcgofhqseejjo",
    "supabase:deploy": "supabase db push",
    "functions:deploy": "supabase functions deploy",
    "functions:serve": "supabase functions serve"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^4.5.0",
    "@simplewebauthn/browser": "^9.0.0",
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/react-query": "^5.17.0",
    "date-fns": "^3.0.0",
    "dompurify": "^3.0.6",
    "exifr": "^7.1.3",
    "framer-motion": "^10.16.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "lucide-react": "^0.300.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-hot-toast": "^2.4.0",
    "react-router-dom": "^6.21.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.32",
    "supabase": "^1.115.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.8",
    "vite-plugin-pwa": "^0.17.4",
    "vitest": "^2.1.9"
  }
}
